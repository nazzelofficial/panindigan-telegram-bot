# Example environment variables for Panindigan Telegram Bot
# Copy this to .env and fill in real values (DO NOT commit secrets)

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# PostgreSQL connection string (DATABASE_URL)
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Example (local DB):
# DATABASE_URL=postgres://postgres:mysecret@localhost:5432/nazzelbots
# Example (managed DB):
# DATABASE_URL=postgres://dbuser:dbpassword@db.example.com:5432/nazzelbots
DATABASE_URL=postgres://postgres:password@localhost:5432/nazzelbots

# Comma-separated admin user IDs (optional)
ADMIN_IDS=123456789,987654321

# Optional: verification endpoint and instance id
# API_VERIFY_URL=https://api.panindigan.com/verify
# INSTANCE_ID=my-instance-001
